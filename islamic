{id:"kafirun",n:"সূরা কাফিরুন",v:[["قُلْ يَا أَيُّهَا الْكَافِرُونَ","কুল ইয়া আইয়ুহাল কাফিরূন","বলুন, হে কাফিররা।"],["لَا أَعْبُدُ مَا تَعْبُدُونَ","লা আ'বুদু মা তা'বুদূন","তোমরা যার ইবাদত করো, আমি তার ইবাদত করি না।"],["وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ","ওয়া লা আনতুম আবিদূনা মা আ'বুদ","আমি যার ইবাদত করি, তোমরা তার ইবাদতকারী নও।"],["وَلَا أَنَا عَابِدٌ مَّا عَبَدتُّمْ","ওয়া লা আনা আবিদুম মা আবাদতুম","তোমরা যার ইবাদত করেছ, আমি তার ইবাদতকারী হব না।"],["وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ","ওয়া লা আনতুম আবিদূনা মা আ'বুদ","আমি যার ইবাদত করি, তোমরা তার ইবাদতকারী হবে না।"],["لَكُمْ دِينُكُمْ وَلِيَ دِينِ","লাকুম দীনুকুম ওয়ালিয়া দীন","তোমাদের দীন তোমাদের, আমার দীন আমার।"]]},
{id:"nasr",n:"সূরা নাসর",v:[["إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ","ইযা জা-আ নাসরুল্লাহি ওয়াল ফাতহ","যখন আল্লাহর সাহায্য ও বিজয় আসবে।"],["وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا","ওয়া রাআইতান নাসা ইয়াদখুলূনা ফী দীনিল্লাহি আফওয়াজা","এবং আপনি মানুষকে দলে দলে আল্লাহর দীনে প্রবেশ করতে দেখবেন।"],["فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا","ফাসাব্বিহ বিহামদি রাব্বিকা ওয়াসতাগফিরহু, ইন্নাহূ কানা তাওওয়াবা","তখন আপনার রবের প্রশংসাসহ তাসবীহ পড়ুন ও ক্ষমা চান; নিশ্চয়ই তিনি তাওবা কবুলকারী।"]]},
{id:"fil",n:"সূরা ফীল",v:[["أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ","আলাম তারা কাইফা ফা'আলা রাব্বুকা বিআসহাবিল ফীল","আপনি কি দেখেননি, আপনার রব হাতিওয়ালাদের সাথে কেমন আচরণ করেছেন?"],["أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ","আলাম ইয়াজ'আল কাইদাহুম ফী তাদলীল","তিনি কি তাদের চক্রান্ত ব্যর্থ করে দেননি?"],["وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","ওয়া আরসালা আলাইহিম তাইরান আবাবীল","তিনি তাদের উপর ঝাঁকে ঝাঁকে পাখি পাঠিয়েছিলেন।"],["تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","তারমীহিম বিহিজারাতিম মিন সিজ্জীল","পাখিরা তাদের উপর পোড়ামাটির পাথর নিক্ষেপ করছিল।"],["فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍ","ফাজা'আলাহুম কা'আসফিম মা'কূল","অতঃপর তিনি তাদের চিবানো ভূসির মতো করে দিলেন।"]]},
{id:"quraysh",n:"সূরা কুরাইশ",v:[["لِإِيلَافِ قُرَيْشٍ","লিঈলাফি কুরাইশ","কুরাইশের নিরাপদ অভ্যাসের কারণে,"],["إِيلَافِهِمْ رِحْلَةَ الشِّتَاءِ وَالصَّيْفِ","ঈলাফিহিম রিহলাতাশ শিতা-ই ওয়াস সাইফ","শীত ও গ্রীষ্মের সফরে তাদের অভ্যস্ত থাকার কারণে।"],["فَلْيَعْبُدُوا رَبَّ هَٰذَا الْبَيْتِ","ফালইয়া'বুদূ রাব্বা হাযাল বাইত","অতএব তারা যেন এই ঘরের রবের ইবাদত করে।"],["الَّذِي أَطْعَمَهُم مِّن جُوعٍ وَآمَنَهُم مِّنْ خَوْفٍ","আল্লাযী আত'আমাহুম মিন জূ'ইঁও ওয়া আমানাহুম মিন খাওফ","যিনি তাদের ক্ষুধায় খাবার দিয়েছেন এবং ভয় থেকে নিরাপত্তা দিয়েছেন।"]]},
{id:"maun",n:"সূরা মাঊন",v:[["أَرَأَيْتَ الَّذِي يُكَذِّبُ بِالدِّينِ","আরাআইতাল্লাযী ইউকাযযিবু বিদ্দীন","আপনি কি তাকে দেখেছেন, যে বিচার দিনকে অস্বীকার করে?"],["فَذَٰلِكَ الَّذِي يَدُعُّ الْيَتِيمَ","ফাযালিকাল্লাযী ইয়াদু''উল ইয়াতীম","সে-ই ইয়াতীমকে রূঢ়ভাবে তাড়িয়ে দেয়।"],["وَلَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ","ওয়ালা ইয়াহুদ্দু আলা তা'আমিল মিসকীন","এবং মিসকীনকে খাবার দিতে উৎসাহ দেয় না।"],["فَوَيْلٌ لِّلْمُصَلِّينَ","ফাওয়াইলুল লিলমুসাল্লীন","অতএব ধ্বংস সেই নামাজীদের জন্য,"],["الَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","আল্লাযীনা হুম আন সালাতিহিম সাহূন","যারা নিজেদের নামাজে অমনোযোগী।"],["الَّذِينَ هُمْ يُرَاءُونَ","আল্লাযীনা হুম ইউরাঊন","যারা লোক দেখানোর জন্য করে।"],["وَيَمْنَعُونَ الْمَاعُونَ","ওয়া ইয়ামনাঊনাল মা'ঊন","এবং নিত্যব্যবহার্য জিনিসপত্র দিতে নিষেধ করে।"]]},
{id:"masad",n:"সূরা মাসাদ (লাহাব)",v:[["تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ","তাব্বাত ইয়াদা আবী লাহাবিওঁ ওয়া তাব্ব","আবু লাহাবের দুই হাত ধ্বংস হোক এবং সে নিজেও ধ্বংস হোক।"],["مَا أَغْنَىٰ عَنْهُ مَالُهُ وَمَا كَسَبَ","মা আগনা আনহু মালুহূ ওয়া মা কাসাব","তার ধনসম্পদ ও উপার্জন তার কোনো কাজে আসেনি।"],["سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ","সাইয়াসলা নারান যাতা লাহাব","সে শীঘ্রই লেলিহান আগুনে প্রবেশ করবে।"],["وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ","ওয়ামরাআতুহূ হাম্মালাতাল হাতাব","এবং তার স্ত্রীও, যে কাঠের বোঝা বহন করে।"],["فِي جِيدِهَا حَبْلٌ مِّن مَّسَدٍ","ফী জীদিহা হাবলুম মিম মাসাদ","তার গলায় থাকবে খেজুর পাতার পাকানো দড়ি।"]]}];
const D2=[
{n:"সানা",w:"নামাজ শুরুতে, তাকবীরে তাহরীমার পর",v:[["سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ وَتَبَارَكَ اسْمُكَ وَتَعَالَىٰ جَدُّكَ وَلَا إِلَٰهَ غَيْرُكَ","সুবহানাকাল্লাহুম্মা ওয়া বিহামদিকা, ওয়া তাবারাকাসমুকা, ওয়া তাআলা জাদ্দুকা, ওয়া লা ইলাহা গাইরুকা","হে আল্লাহ, আপনি পবিত্র, আপনার প্রশংসা করছি। আপনার নাম বরকতময়, আপনার মর্যাদা সুউচ্চ এবং আপনি ছাড়া কোনো ইলাহ নেই।"]]},
{n:"রুকুর তাসবীহ",w:"রুকুতে ৩ বার",v:[["سُبْحَانَ رَبِّيَ الْعَظِيمِ","সুবহানা রাব্বিয়াল আযীম","আমার মহান রবের পবিত্রতা ঘোষণা করছি।"]]},
{n:"কওমার দোয়া",w:"রুকু থেকে উঠে",v:[["سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ","সামিআল্লাহু লিমান হামিদাহ","যে আল্লাহর প্রশংসা করে, আল্লাহ তা শোনেন।"],["رَبَّنَا لَكَ الْحَمْدُ","রাব্বানা লাকাল হামদ","হে আমাদের রব, সব প্রশংসা আপনারই।"]]},
{n:"সিজদার তাসবীহ",w:"সিজদায় ৩ বার",v:[["سُبْحَانَ رَبِّيَ الْأَعْلَىٰ","সুবহানা রাব্বিয়াল আ'লা","আমার সর্বোচ্চ রবের পবিত্রতা ঘোষণা করছি।"]]},
{n:"তাশাহহুদ (আত্তাহিয়্যাতু)",w:"প্রতি বৈঠকে",v:[["التَّحِيَّاتُ لِلَّهِ وَالصَّلَوَاتُ وَالطَّيِّبَاتُ","আত্তাহিয়্যাতু লিল্লাহি ওয়াস সালাওয়াতু ওয়াত তাইয়্যিবাত","সব মৌখিক, শারীরিক ও আর্থিক ইবাদত আল্লাহর জন্য।"],["السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ","আসসালামু আলাইকা আইয়ুহান নাবিয়্যু ওয়া রাহমাতুল্লাহি ওয়া বারাকাতুহ","হে নবী, আপনার প্রতি সালাম এবং আল্লাহর রহমত ও বরকত।"],["السَّلَامُ عَلَيْنَا وَعَلَىٰ عِبَادِ اللَّهِ الصَّالِحِينَ","আসসালামু আলাইনা ওয়া আলা ইবাদিল্লাহিস সালিহীন","আমাদের এবং আল্লাহর নেক বান্দাদের প্রতি সালাম।"],["أَشْهَدُ أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ","আশহাদু আল্লা ইলাহা ইল্লাল্লাহু ওয়া আশহাদু আন্না মুহাম্মাদান আবদুহূ ওয়া রাসূলুহ","আমি সাক্ষ্য দিচ্ছি আল্লাহ ছাড়া কোনো ইলাহ নেই এবং মুহাম্মাদ ﷺ তাঁর বান্দা ও রাসূল।"]]},
{n:"দরুদে ইবরাহীম",w:"শেষ বৈঠকে, তাশাহহুদের পর",v:[["اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَعَلَىٰ آلِ مُحَمَّدٍ كَمَا صَلَّيْتَ عَلَىٰ إِبْرَاهِيمَ وَعَلَىٰ آلِ إِبْرَاهِيمَ إِنَّكَ حَمِيدٌ مَجِيدٌ","আল্লাহুম্মা সাল্লি আলা মুহাম্মাদিউ ওয়া আলা আলি মুহাম্মাদিন, কামা সাল্লাইতা আলা ইবরাহীমা ওয়া আলা আলি ইবরাহীমা, ইন্নাকা হামীদুম মাজীদ","হে আল্লাহ, মুহাম্মাদ ﷺ ও তাঁর পরিবারের উপর রহমত বর্ষণ করুন, যেমন ইবরাহীম আ. ও তাঁর পরিবারের উপর করেছেন। আপনি প্রশংসিত ও মহিমান্বিত।"],["اللَّهُمَّ بَارِكْ عَلَىٰ مُحَمَّدٍ وَعَلَىٰ آلِ مُحَمَّدٍ كَمَا بَارَكْتَ عَلَىٰ إِبْرَاهِيمَ وَعَلَىٰ آلِ إِبْرَاهِيمَ إِنَّكَ حَمِيدٌ مَجِيدٌ","আল্লাহুম্মা বারিক আলা মুহাম্মাদিউ ওয়া আলা আলি মুহাম্মাদিন, কামা বারাকতা আলা ইবরাহীমা ওয়া আলা আলি ইবরাহীমা, ইন্নাকা হামীদুম মাজীদ","হে আল্লাহ, মুহাম্মাদ ﷺ ও তাঁর পরিবারের উপর বরকত দান করুন, যেমন ইবরাহীম আ. ও তাঁর পরিবারের উপর করেছেন। আপনি প্রশংসিত ও মহিমান্বিত।"]]},
{n:"দোয়া (রাব্বানা আতিনা)",w:"দরুদের পর, সালামের আগে",v:[["رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ","রাব্বানা আতিনা ফিদ দুনইয়া হাসানাতাঁও ওয়া ফিল আখিরাতি হাসানাতাঁও ওয়া কিনা আযাবান নার","হে আমাদের রব, আমাদের দুনিয়াতে কল্যাণ দিন, আখিরাতেও কল্যাণ দিন এবং জাহান্নামের আযাব থেকে রক্ষা করুন।"]]}];
