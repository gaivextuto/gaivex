const Q=[['ফজরের ফরজ নামাজ কত রাকাত?',['২','৩','৪'],0],['মাগরিবের ফরজ নামাজ কত রাকাত?',['২','৩','৪'],1],['ওযুতে কোন অংশ মাসেহ করা হয়?',['পা','মাথা','হাত'],1],['নামাজ শুরুর প্রথম তাকবীরকে কী বলে?',['তাকবীরে তাহরীমা','কওমা','জালসা'],0],['সিজদায় কোন তাসবীহ পড়া হয়?',['সুবহানা রাব্বিয়াল আযীম','সুবহানা রাব্বিয়াল আলা','সামিআল্লাহু লিমান হামিদাহ'],1]];let qi=0,qs=0;
