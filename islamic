const KAL=[['لَا إِلَٰهَ إِلَّا اللَّهُ مُحَمَّدٌ رَسُولُ اللَّهِ','লা ইলাহা ইল্লাল্লাহু মুহাম্মাদুর রাসূলুল্লাহ','আল্লাহ ছাড়া কোনো ইলাহ নেই, মুহাম্মাদ ﷺ আল্লাহর রাসূল।'],['أَشْهَدُ أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ','আশহাদু আল্লা ইলাহা ইল্লাল্লাহু ওয়াহদাহূ লা শারীকা লাহূ, ওয়া আশহাদু আন্না মুহাম্মাদান আবদুহূ ওয়া রাসূলুহ','আমি সাক্ষ্য দিচ্ছি আল্লাহ ছাড়া কোনো ইলাহ নেই, তিনি একক, তাঁর কোনো শরীক নেই; এবং মুহাম্মাদ ﷺ তাঁর বান্দা ও রাসূল।']];
const AZ=[['اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ','আল্লাহু আকবার, আল্লাহু আকবার','আল্লাহ সবচেয়ে মহান। (শুরুতে মোট ৪ বার)'],['أَشْهَدُ أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ','আশহাদু আল্লা ইলাহা ইল্লাল্লাহ','আমি সাক্ষ্য দিচ্ছি আল্লাহ ছাড়া কোনো ইলাহ নেই। (২ বার)'],['أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ','আশহাদু আন্না মুহাম্মাদার রাসূলুল্লাহ','আমি সাক্ষ্য দিচ্ছি মুহাম্মাদ ﷺ আল্লাহর রাসূল। (২ বার)'],['حَيَّ عَلَى الصَّلَاةِ','হাইয়্যা আলাস সালাহ','নামাজের জন্য এসো। (২ বার)'],['حَيَّ عَلَى الْفَلَاحِ','হাইয়্যা আলাল ফালাহ','কল্যাণের জন্য এসো। (২ বার)'],['الصَّلَاةُ خَيْرٌ مِنَ النَّوْمِ','আসসালাতু খাইরুম মিনান নাওম','নামাজ ঘুম থেকে উত্তম। (শুধু ফজরে, ২ বার)'],['اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ','আল্লাহু আকবার, আল্লাহু আকবার','আল্লাহ সবচেয়ে মহান। (২ বার)'],['لَا إِلَٰهَ إِلَّا اللَّهُ','লা ইলাহা ইল্লাল্লাহ','আল্লাহ ছাড়া কোনো ইলাহ নেই। (১ বার)']];
const DAILY=[['খাওয়ার আগে','بِسْمِ اللَّهِ وَعَلَىٰ بَرَكَةِ اللَّهِ','বিসমিল্লাহি ওয়া আলা বারাকাতিল্লাহ','আল্লাহর নামে ও আল্লাহর বরকতের উপর (শুরু করছি)।'],['খাওয়ার পরে','الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنَا وَسَقَانَا وَجَعَلَنَا مُسْلِمِينَ','আলহামদুলিল্লাহিল্লাযী আতআমানা ওয়া সাকানা ওয়া জাআলানা মুসলিমীন','সব প্রশংসা আল্লাহর, যিনি আমাদের খাইয়েছেন, পান করিয়েছেন এবং মুসলিম বানিয়েছেন।'],['ঘুমানোর আগে','بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا','বিসমিকাল্লাহুম্মা আমূতু ওয়া আহইয়া','হে আল্লাহ, আপনার নামেই আমি মরি (ঘুমাই) ও বাঁচি (জাগি)।'],['ঘুম থেকে উঠে','الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ','আলহামদুলিল্লাহিল্লাযী আহইয়ানা বাদা মা আমাতানা ওয়া ইলাইহিন নুশূর','সব প্রশংসা আল্লাহর, যিনি মৃত্যুর (ঘুমের) পর আমাদের জীবিত করেছেন। তাঁর কাছেই ফিরে যেতে হবে।'],['মসজিদে ঢোকার সময়','اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ','আল্লাহুম্মাফতাহ লী আবওয়াবা রাহমাতিক','হে আল্লাহ, আমার জন্য আপনার রহমতের দরজা খুলে দিন।'],['মসজিদ থেকে বের হওয়ার সময়','اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ','আল্লাহুম্মা ইন্নী আসআলুকা মিন ফাদলিক','হে আল্লাহ, আমি আপনার অনুগ্রহ চাই।'],['ওযুর পরে','أَشْهَدُ أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ','আশহাদু আল্লা ইলাহা ইল্লাল্লাহু ওয়াহদাহূ লা শারীকা লাহূ, ওয়া আশহাদু আন্না মুহাম্মাদান আবদুহূ ওয়া রাসূলুহ','আমি সাক্ষ্য দিচ্ছি আল্লাহ ছাড়া কোনো ইলাহ নেই, তিনি একক; এবং মুহাম্মাদ ﷺ তাঁর বান্দা ও রাসূল।']];
