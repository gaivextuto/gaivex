const x=Q[qi];q.innerHTML=`<p><b>${qi+1}. ${x[0]}</b></p>`+x[1].map((o,i)=>`<button class="opt" data-i="${i}">${o}</button>`).join('');
q.querySelectorAll('.opt').forEach(b=>b.onclick=()=>{const ok=+b.dataset.i===x[2];if(ok)qs++;b.classList.add(ok?'ok':'no');q.querySelectorAll('.opt').forEach(o=>{o.disabled=true;if(+o.dataset.i===x[2])o.classList.add('ok')});setTimeout(()=>{qi++;qr()},900)})}qr();
